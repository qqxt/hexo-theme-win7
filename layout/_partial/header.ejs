<%
    // 计算面包屑：主页 ▸ 当前位置
    var crumbLabel = '';
    if (is_home()) { crumbLabel = ''; }
    else if (is_archive() || is_current('archives')) { crumbLabel = '归档'; }
    else if (is_current('about')) { crumbLabel = '关于'; }
    else if (is_tag()) { crumbLabel = '标签：' + page.tag; }
    else if (is_current('tags')) { crumbLabel = '标签'; }
    else if (page.title) { crumbLabel = page.title.length > 15 ? page.title.slice(0, 15) + '…' : page.title; }
%>
<div class="explorer-toolbar">
    <div class="locationbar">
        <button type="button" id="mobileMenuToggle" class="mobile-menu-toggle" aria-label="菜单" aria-expanded="false" aria-controls="explorerSidebar">
            <span class="mmt-bar"></span><span class="mmt-bar"></span><span class="mmt-bar"></span>
        </button>

        <div class="navbutton">
            <div class="leftnavbutton" title="返回到上一页" onclick="history.back()" aria-label="后退">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14.7 5.3 8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z"/></svg>
            </div>
            <div class="rightnavbutton" title="前进到下一页" onclick="history.forward()" aria-label="前进">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9.3 5.3 16 12l-6.7 6.7-1.4-1.4L13.2 12 7.9 6.7z"/></svg>
            </div>
        </div>

        <ul id="nav-breadcrumbs" class="nav-breadcrumbs linklist1 navlinks" role="menubar">
            <li class="crumbg breadcrumbsbg">
                <img src="<%- url_for('/image/vista/ui/drive.svg') %>" alt="" class="crumb-drive">
                <span class="crumb1"></span>
                <span class="crumb"><a href="<%- url_for('/') %>" accesskey="h"><span><%= config.title %></span></a></span>
                <% if (crumbLabel) { %>
                    <span class="crumb"><a href="#" onclick="return false;"><span><%= crumbLabel %></span></a></span>
                <% } %>
                <div class="locationbutton" aria-label="位置选项">
                    <svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true"><path fill="currentColor" d="M2 4.2 6 8.2l4-4z"/></svg>
                </div>
                <div class="refreshbutton" title="刷新" aria-label="刷新" onclick="if(window.__win7ShowLoading)window.__win7ShowLoading();location.reload();">
                    <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><path fill="currentColor" d="M13.6 8a5.6 5.6 0 1 1-1.64-3.96l-.02-.02L13.3 2.7v4.3H9L10.9 5.1A4 4 0 1 0 12 8z"/></svg>
                </div>
                <button type="button" id="mobileSearchToggle" class="mobile-search-toggle" aria-label="搜索" aria-expanded="false" aria-controls="siteSearchInput">
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M6.5 1a5.5 5.5 0 0 1 4.23 9.02l3.62 3.63-1.06 1.06-3.63-3.62A5.5 5.5 0 1 1 6.5 1zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/></svg>
                </button>
            </li>
            <li id="search-box" class="search-box rightside responsive-hide">
                <label class="address-search">
                    <input id="siteSearchInput" class="inputbox search addressbarsearch" type="search" placeholder="搜索 <%= config.title %>" aria-label="search" autocomplete="off">
                    <span class="search-clear" id="siteSearchClear" title="清除" aria-label="清除">×</span>
                </label>
            </li>
        </ul>
    </div>
</div>
