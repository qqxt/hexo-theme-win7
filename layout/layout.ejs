<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <% if (page.title) { %><%= page.title %> · <% } %><%= config.title %>
    </title>
<%
    // SEO：页面级描述/关键词。文章/页面优先取 front-matter 的 description，
    // 没有则从摘要、正文截取兜底；首页等其他页面回退到全站 description。
    var seoDesc = '';
    if (is_post() || is_page()) {
        if (page.description) {
            seoDesc = String(page.description);
        } else if (page.excerpt) {
            seoDesc = strip_html(page.excerpt).replace(/\s+/g, ' ').trim();
        } else if (page.content) {
            seoDesc = strip_html(page.content).replace(/\s+/g, ' ').trim();
        }
        seoDesc = seoDesc.slice(0, 150);
    } else if (config.description) {
        seoDesc = config.description;
    }
    var seoKeywords = '';
    if (page.keywords) {
        seoKeywords = Array.isArray(page.keywords) ? page.keywords.join(',') : String(page.keywords);
    } else if (page.tags && page.tags.length) {
        seoKeywords = page.tags.map(function (t) { return t.name; }).join(',');
    }
    var canonicalUrl = url_for(page.path || '', { absolute: true });
%>
    <% if (seoDesc) { %>
        <meta name="description" content="<%= seoDesc %>">
    <% } %>
    <% if (seoKeywords) { %>
        <meta name="keywords" content="<%= seoKeywords %>">
    <% } %>
    <link rel="canonical" href="<%- canonicalUrl %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:title" content="<%= page.title ? page.title : config.title %>">
    <% if (seoDesc) { %>
        <meta property="og:description" content="<%= seoDesc %>">
    <% } %>
    <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
    <meta property="og:url" content="<%- canonicalUrl %>">
    <meta property="og:locale" content="zh_CN">
    <% if (is_post()) { %>
        <script type="application/ld+json">
<%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: page.title,
    description: seoDesc,
    datePublished: date_xml(page.date),
    dateModified: date_xml(page.updated || page.date),
    author: { '@type': 'Person', name: config.author },
    publisher: { '@type': 'Organization', name: config.title },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }
}) %>
        </script>
    <% } %>
    <% if (config.feed && config.feed.path) { %>
        <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%= url_for(config.feed.path) %>">
    <% } %>
    <link rel="stylesheet" href="<%- url_for('vendor/7.css') %>?v=<%= asset_version('vendor/7.css') %>">
    <link rel="stylesheet" href="<%- url_for('css/style.css') %>?v=<%= asset_version('css/style.css') %>">
    <% if (theme.hljs) { %>
        <link rel="stylesheet" href="<%- url_for('vendor/hljs.css') %>?v=<%= asset_version('vendor/hljs.css') %>">
    <% } %>
    <% if (theme.favicon && theme.favicon.enable && theme.favicon.icon) { %>
        <link rel="icon" href="<%= url_for(theme.favicon.icon) %>">
    <% } %>
    <!-- Bing 站点所有权验证 meta（Bing Webmaster Tools） -->
    <meta name="msvalidate.01" content="4B91840282D62109732CCA5559E2F81E" />
</head>

<body>
    <div class="win7-loading" id="win7Loading" aria-hidden="true">
        <div class="win7-spinner" role="status" aria-label="加载中"></div>
    </div>
    <script src="<%- url_for('js/loading.js') %>?v=<%= asset_version('js/loading.js') %>"></script>

    <div class="desktop">
        <div class="window main-window glass active">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img class="win-icon" src="<%- url_for('/image/icon/vista_pc_1.jpg') %>" alt="">
                    <% if ((is_post() || is_page()) && page.title) { %>
                        <%= page.title.length > 20 ? page.title.slice(0, 20) + '…' : page.title %>----<%= config.title %>
                    <% } else { %>
                        <%= config.title %><% if (config.subtitle) { %> — <%= config.subtitle %><% } %>
                    <% } %>
                </div>
                <div class="title-bar-controls">
                    <button aria-label="Minimize"></button>
                    <button aria-label="Maximize"></button>
                    <button aria-label="Close"></button>
                </div>
            </div>

            <%- partial('_partial/header') %>

            <% if (is_home()) { %>
                <%- partial('_partial/view-tabs') %>
            <% } else { %>
                <%- partial('_partial/view-tabs-static') %>
            <% } %>

            <% if (theme.music && theme.music.enable && theme.music.songs && theme.music.songs.length && theme.music.songs[0].url) { %>
                <%- partial('_partial/widget') %>
            <% } %>

            <%- partial('_partial/attachments') %>

            <div class="window-body explorer-body">
                <%- partial('_partial/sidebar') %>

                <div class="explorer-content">
                    <main id="main-container">
                        <%- body %>
                    </main>
                </div>
            </div>

            <% if (is_home() || is_archive() || is_current('archives')) { %>
                <div class="details-pane">
                    <img src="<%- url_for('/image/vista/ui/viewforums.webp') %>" alt="" class="details-pane-ico">
                    <span class="details-pane-text"><%= site.posts.length %> 篇文章</span>
                </div>
            <% } %>

            <%- partial('_partial/footer') %>
        </div>
    </div>

    <%- partial('_partial/context-menu') %>

    <div class="scroll-page" aria-hidden="true">
        <i class="scroll-up" title="回到顶部" aria-label="回到顶部">
            <svg viewBox="0 0 24 16" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M12 2 2.5 11.5l1.9 1.9L12 5.8l7.6 7.6 1.9-1.9z"/></svg>
        </i>
        <i class="scroll-down" title="到底部" aria-label="到底部">
            <svg viewBox="0 0 24 16" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M12 14 21.5 4.5 19.6 2.6 12 10.2 4.4 2.6 2.5 4.5z"/></svg>
        </i>
    </div>

    <script>window.__win7Root = '<%- url_for("/") %>';</script>
    <script defer src="<%- url_for('js/bundle.js') %>?v=<%= asset_version('js/bundle.js') %>"></script>
    <% if (theme.music && theme.music.enable) { %>
        <script defer src="<%- url_for('js/music.js') %>?v=<%= asset_version('js/music.js') %>"></script>
    <% } %>

    <% /* 动态相对时间：前端用 data-date 实时计算，避免静态站“构建后永远几分钟前”的问题。
          无 JS 时回退到后端 helper 构建时输出的相对时间。 */ %>
    <script>
    (function () {
      var DAY = 86400;
      function toSeconds(s) {
        // s 现在是绝对 Unix 秒字符串（不再按本地时区解析），直接解析，任何时区下结果一致
        var t = parseInt(s, 10);
        return isNaN(t) ? NaN : t;
      }
      function startOfDay(ts) { var d = new Date(ts * 1000); d.setHours(0, 0, 0, 0); return Math.floor(d.getTime() / 1000); }
      function startOfMonth(ts) { var d = new Date(ts * 1000); d.setDate(1); d.setHours(0, 0, 0, 0); return Math.floor(d.getTime() / 1000); }
      function startOfYear(ts) { var d = new Date(ts * 1000); d.setMonth(0, 1); d.setHours(0, 0, 0, 0); return Math.floor(d.getTime() / 1000); }
      function relative(ts) {
        if (isNaN(ts)) return '';
        var now = Math.floor(Date.now() / 1000);
        var today = startOfDay(now);
        var diff = now - ts;
        if (diff < 0) return '刚刚'; // 防御：文章时间在未来时显示"刚刚"
        if (diff < 60) return '刚刚';
        if (diff < 3600) return Math.floor(diff / 60) + ' 分钟前';
        if (diff < DAY) return Math.floor(diff / 3600) + ' 小时前';
        var td = startOfDay(ts);
        var n2 = ['昨', '前'];
        for (var k = 0; k < n2.length; k++) { if (today - DAY * (1 + k) <= td) return n2[k] + '天'; }
        var week = ['日', '一', '二', '三', '四', '五', '六'];
        var dow = new Date(now * 1000).getDay(); if (dow === 0) dow = 7;
        var wStart = today - DAY * dow;
        var wn = ['', '上'];
        for (var j = 0; j < wn.length; j++) { if (wStart - DAY * 7 * j < td) return wn[j] + '周' + week[new Date(ts * 1000).getDay()]; }
        if (wStart - DAY * 14 < td) return '3 周前';
        var mStart = startOfMonth(now);
        if (mStart <= td) return Math.floor((today - td) / DAY) + ' 天前';
        var prev = startOfMonth(mStart - 1);
        if (prev <= td) return '上月';
        var yStart = startOfYear(now);
        if (yStart <= td) return (new Date(now * 1000).getMonth() + 1 - (new Date(ts * 1000).getMonth() + 1)) + ' 月前';
        var yn = ['去', '前'], yc = yStart;
        for (var i = 0; i < yn.length; i++) { yc = startOfYear(yc - 1); if (yc <= td) return yn[i] + '年'; }
        return (new Date(now * 1000).getFullYear() - new Date(ts * 1000).getFullYear()) + ' 年前';
      }
      function update() {
        var els = document.querySelectorAll('.col-date[data-date]');
        for (var i = 0; i < els.length; i++) {
          var t = toSeconds(els[i].getAttribute('data-date'));
          var r = relative(t);
          if (r) els[i].textContent = r;
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { update(); setInterval(update, 60000); });
      } else {
        update();
        setInterval(update, 60000);
      }
    })();
    </script>

    <% if (theme.math && theme.math.enable && page.mathjax) { %>
        <script>
            window.MathJax = {
                tex: {
                    inlineMath: [['$', '$'], ["\\(", "\\)"]],
                    displayMath: [['$$', '$$'], ["\\[", "\\]"]],
                    processEscapes: true
                },
                options: {
                    skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
                }
            };
        </script>
        <script src="<%= url_for(theme.math.local_src) %>" id="MathJax-script" async></script>
    <% } %>
    <!-- 百度统计（置于 body 末尾并异步加载，避免阻塞首屏渲染） -->
    <script>
    var _hmt = _hmt || [];
    (function() {
      var hm = document.createElement("script");
      hm.async = true;
      hm.src = "https://hm.baidu.com/hm.js?5b492345c8e832875d67101a1074c999";
      var s = document.getElementsByTagName("script")[0];
      s.parentNode.insertBefore(hm, s);
    })();
    </script>
</body>

</html>
